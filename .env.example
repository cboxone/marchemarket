APP_NAME="MarcheMarket"
APP_ENV=local
APP_KEY=
# true en développement local uniquement : en production, laissez false
# (le mode debug affiche le code, la config et parfois des secrets aux visiteurs).
APP_DEBUG=false
APP_TIMEZONE=Africa/Porto-Novo
APP_URL=http://localhost:8000
APP_LOCALE=fr

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=marchemarket
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
QUEUE_CONNECTION=database
CACHE_STORE=database

FILESYSTEM_DISK=public

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_FROM_ADDRESS="contact@marchemarket.test"
MAIL_FROM_NAME="${APP_NAME}"

# Mobile Money / carte bancaire via KkiaPay (https://kkiapay.me)
# Clés à récupérer sur votre tableau de bord KkiaPay (compte gratuit).
KKIAPAY_PUBLIC_KEY=
KKIAPAY_PRIVATE_KEY=
KKIAPAY_SECRET_KEY=
KKIAPAY_SANDBOX=true
KKIAPAY_WEBHOOK_SECRET=

# Règles de la marketplace (voir config/marketplace.php)
# Commission prélevée sur les ventes de chaque vendeur, en % (0 = aucune).
# 10 est une valeur d'exemple : à fixer selon votre modèle économique.
PLATFORM_COMMISSION_PERCENT=10
# Délai avant annulation automatique d'une commande non payée (minutes, minimum 10).
UNPAID_ORDER_TTL_MINUTES=60

# Délai laissé au fournisseur pour répondre à une demande de devis (jours)
QUOTE_REQUEST_DAYS=14

# Délai avant qu'un reversement encaissé devienne retirable (jours)
PAYOUT_RELEASE_AFTER_DELIVERY_DAYS=7
PAYOUT_RELEASE_AFTER_SHIPPING_DAYS=21
PAYOUT_RELEASE_AFTER_PAYMENT_DAYS=45

# Second moyen de paiement : virement bancaire manuel (voir README).
# Laissez BANK_TRANSFER_ACCOUNT_NUMBER et BANK_TRANSFER_IBAN vides pour
# masquer complètement cette option sur la page de paiement.
BANK_TRANSFER_BANK_NAME=
BANK_TRANSFER_ACCOUNT_NAME=
BANK_TRANSFER_ACCOUNT_NUMBER=
BANK_TRANSFER_IBAN=
BANK_TRANSFER_SWIFT=
BANK_TRANSFER_WINDOW_HOURS=72

# Litiges acheteur/fournisseur
DISPUTE_WINDOW_AFTER_DELIVERY_DAYS=7
DISPUTE_WINDOW_AFTER_PAYMENT_DAYS=15
DISPUTE_VENDOR_RESPONSE_HOURS=72
DISPUTE_ADMIN_TARGET_DAYS=5

# Identité légale imprimée sur les factures (voir config/marketplace.php)
PLATFORM_LEGAL_NAME="MarcheMarket"
PLATFORM_LEGAL_ADDRESS=
PLATFORM_LEGAL_PHONE=
PLATFORM_LEGAL_EMAIL=
PLATFORM_TAX_ID=
PLATFORM_REGISTRATION_NUMBER=
INVOICE_FOOTER=

# Monitoring d'erreurs (facultatif — https://sentry.io ou instance auto-hébergée).
# Laissez vide pour désactiver complètement l'envoi de données à Sentry.
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0

VITE_APP_NAME="${APP_NAME}"
